# ===== 服务监听 =====
# 容器内必须是 0.0.0.0，否则宿主机访问不到
NODE_ENV=production
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# ===== 数据库 =====
# docker compose 部署：主机名用 db（服务名）
DATABASE_URL=postgres://jxc:jxc123456@db:5432/jxc
# 直接跑在宿主机（不用容器）时改成：
# DATABASE_URL=postgres://jxc:jxc123456@127.0.0.1:5432/jxc
DATABASE_POOL_MAX=10

# ===== 前端部署路径 =====
# 部署在子路径（如 http://nas:3000/jxc）时填写 /jxc；直接根路径访问时留空
CLIENT_BASE_PATH=

# ===== 可选：日志级别（沿用原模板变量，留空即默认） =====
LOG_LEVEL=
